{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LINE",
  "version": "0.1.0",
  "identifier": "dev.lineapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "LINE",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "publisher": "lineapp",
    "category": "SocialNetworking",
    "shortDescription": "Desktop client for LINE",
    "longDescription": "A desktop client for the protocol the LINE desktop app speaks. Login, chats, history, and send run on this machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional"
      }
    }
  }
}
